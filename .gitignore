htmlcov/
build/
dist/
*.egg-info/

# Local environment files — credentials never belong in a public repo
.env
.env.*

# Skills installed by setup into a consuming project are generated copies;
# this repo becomes its own consumer once it dogfoods itself
.agents/

# Run-scoped workflow artifacts ({artifacts}/runs/<run-id>/) are deliberately
# NOT ignored: gate instrumentation from dogfooded runs is a deliverable
